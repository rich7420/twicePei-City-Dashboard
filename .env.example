# Frontend 環境變數
NODE_ENV=production
VITE_API_URL=https://your-domain.com/api
VITE_APP_TITLE=臺北市儀表板
VITE_APP_VERSION=2.2.0
VITE_MAPBOXTILE=mapbox://styles/mapbox/streets-v11
VITE_MAPBOXTOKEN=your_mapbox_token
VITE_TAIPEIPASS_URL=https://auth-domain.com
VITE_TAIPEIPASS_CLIENT_ID=your_client_id
VITE_TAIPEIPASS_SCOPE=your_scope

# Backend 環境變數
GIN_MODE=release
GIN_DOMAIN=your-domain.com
GIN_PORT=8080
JWT_SECRET=your_jwt_secret
IDNO_SALT=your_salt
ISSO_CLIENT_ID=your_client_id
ISSO_CLIENT_SECRET=your_client_secret

# 資料庫環境變數
DB_DASHBOARD_HOST=postgres-data
DB_DASHBOARD_USER=postgres
DB_DASHBOARD_PASSWORD=your_password
DB_DASHBOARD_DBNAME=taipei_city_dashboard
DB_DASHBOARD_PORT=5432
DB_MANAGER_HOST=postgres-manager
DB_MANAGER_USER=postgres
DB_MANAGER_PASSWORD=your_password
DB_MANAGER_DBNAME=taipei_city_dashboard_manager
DB_MANAGER_PORT=5432

# Redis 環境變數
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0